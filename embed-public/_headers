# Cloudflare static-asset response headers for the embed CDN (Workers static assets).
# The script is loaded as a module from GoDaddy's iframe, which requires CORS.
# The CSP only takes effect on the demo pages served from here: GoDaddy's page governs the embed.
/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https: data:; connect-src 'self' https:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Content-hashed chunks never change: cache them for a year.
/mockApi-*
  Cache-Control: public, max-age=31536000, immutable

# artist-epk.js keeps a fixed URL (it's what GoDaddy links to), so browsers
# revalidate it and pick up each deploy right away.
/artist-epk.js
  Cache-Control: public, max-age=0, must-revalidate
