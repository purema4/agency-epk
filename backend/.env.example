# Copy to .env and fill in. Never commit the real token.
# Twenty server URL (no trailing /graphql) and an API key from Settings -> APIs & Webhooks.
CRM_BASE_URL=http://localhost:8001
CRM_API_TOKEN=dev-token
CRM_GRAPHQL_PATH=/graphql
CRM_TIMEOUT_SECONDS=5
# How long a CRM answer is reused before asking the CRM again.
CACHE_TTL_SECONDS=60
